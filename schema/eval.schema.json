{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ever-works/agents/blob/main/schema/eval.schema.json",
  "title": "Ever Works — Agent Template Eval",
  "description": "Conversation-level behavioral eval for a single Agent template. One eval file per template, named eval/<slug>.yml. Each conversation is a multi-turn transcript plus a list of expectations the assistant's behavior must satisfy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "description", "conversations"],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,60}$",
      "description": "Template slug this eval targets. Must match a slug in manifest.json."
    },
    "description": {
      "type": "string",
      "minLength": 8,
      "maxLength": 500,
      "description": "What this eval covers and why it exists."
    },
    "conversations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "turns", "expectations"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,80}$",
            "description": "Stable id for this conversation (unique within the eval file)."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "description": "Human-readable name for this conversation."
          },
          "turns": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["role", "content"],
              "properties": {
                "role": {
                  "enum": ["user", "assistant"],
                  "description": "Speaker for this turn."
                },
                "content": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Turn text. Multi-line allowed."
                }
              }
            }
          },
          "expectations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "description": "Assertions the assistant's behavior must satisfy. Mix of MUST and MUST NOT statements.",
            "items": {
              "type": "string",
              "minLength": 8,
              "maxLength": 500
            }
          }
        }
      }
    }
  }
}
